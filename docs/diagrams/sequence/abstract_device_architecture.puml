title 1. Módulos principales y dependencias (v1.5.1-SNAPSHOT)

package "data-types" as DT {
  component "x73-idl\n\nIEEE 11073 IDL\n+ perfiles QoS\n(ice_library.xml)" as IDL
  component "x73-idl-rti-dds\n\nBUILD: tipos Java generados\npor RTI (iceddsgenJava)" as GEN
  component "org.mdpnp.rtiapi.data\n\nEventLoop · QosProfiles\nTopicUtil · InstanceModel*" as RTIAPI
}

package "devices/*" as DEV {
  component "Protocolos puros (sin UI)\n\nMedibus · Intellivue\nStateMachine · NetworkConnection\nDeviceClock" as PROT
}

package "interop-lab" as IL {
  component "demo-devices\n\nFRAMEWORK DE DRIVERS\nAbstractDevice y su jerarquía\nContextos Spring · JMX\nTimeManager · Partition" as DD
  component "demo-guis*\n\nComponentes visuales\n(javafx=17.0.11)" as GUIS
  component "demo-apps\n\nSUPERVISOR (JavaFX 25)\norg.mdpnp.apps.testapp.Main" as DA
  component "demo-jserialcomm\n\nSerialProvider (jserialcomm)" as JSC
}

component "headless-adapter\n\nRUNTIME SIN JAVAFX\norg.mdpnp.headless.HeadlessMain" as HA

component "RTI Connext DDS\n(nativo)" as RTI
component "Spring 6.0.2" as SPRING

component "HL7 v2 / FHIR R4\nGateway :8080 · HAPI :8099\nKeycloak :9080" as FHIR
component "Mosquitto\n(openice/{udi}/{metric})" as MQTT

IDL --> GEN : fuentes
GEN --> RTIAPI : tipos + QoS
DD --> PROT : usa (parser del protocolo)
PROT --> DD : provee tipos base reutilizables

DA --> DD : implementa drivers
DA --> GUIS
DD --> JSC : implementa / usa
HA --> DD : implementa drivers
HA --> JSC

DD --> RTIAPI : importa
DD --> SPRING : contextos XML
DA --> SPRING
HA --> SPRING

DD --> RTI : participant/publisher/subscriber
DA --> RTI : lectores (Supervisor)
HA --> RTI : lectores (Pi)

RTI --> FHIR : Numeric → Observation
DA --> MQTT : app MQTT Send

note right of DD
  **Único módulo que contiene
  AbstractDevice.java.**
  Todo driver hereda de aquí.
  No depende de JavaFX.
end note

note bottom of GEN
  Código generado, no se edita.
  compileJava.dependsOn iceddsgenJava
end note
@enduml


