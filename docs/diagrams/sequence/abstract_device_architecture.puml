title 3. Anatomía de AbstractDevice (qué contiene y qué expone)

abstract class AbstractDevice {
  --
  -- Infraestructura (inyectada por Spring) --
  # EventLoop eventLoop
  # ScheduledExecutorService executor
  # DomainParticipant domainParticipant
  # Publisher publisher
  # Subscriber subscriber
  --
  -- Identidad --
  # DeviceIdentity deviceIdentity
  # getDeviceIdentity() · getManufacturer()
    getModel() · getUniqueDeviceIdentifier()
  # writeDeviceIdentity()
  # iconOrBlank(model, icon)
  # iconResourceName()
  --
  -- Escritores (1 por tópico) --
  # DeviceIdentityDataWriter
  # NumericDataWriter
  # SampleArrayDataWriter
  # AlarmLimitDataWriter
  # LocalAlarmLimitObjectiveDataWriter
  # DeviceAlertConditionDataWriter
  # AlertDataWriter patientAlertWriter
  # AlertDataWriter technicalAlertWriter
  --
  -- Lector (el único) --
  # GlobalAlarmLimitObjectiveDataReader
  # ReadCondition alarmLimitObjectiveCondition
  --
  -- API para el driver (protegida) --
  + {static} InstanceHolder<T> createNumericInstance(...)
  + numericSample(...) «6 sobrecargas»
  + {static} InstanceHolder<T> createSampleArrayInstance(...)
  + sampleArraySample(...) «5 sobrecargas»
  + createAlarmLimitInstance(...) / alarmLimitSample(...)
  + createAlarmLimitObjectiveInstance(...) / alarmLimitObjectiveSample(...)
  + writePatientAlert(key, value) / markOld / clearOld
  + writeTechnicalAlert(key, value) / markOld / clearOld
  + writeDeviceAlert(alertState)
  + unregisterAllInstances()
  + {static} DeviceClock getClockProvider()
  + setAlarmLimit(GlobalAlarmLimitObjective) «hook vacío»
  + unsetAlarmLimit(metricId, limitType) «hook vacío»
  --
  -- Ciclo de vida --
  + init() «hook vacío, post-construcción»
  + shutdown() «borra lectores/escritores/tópicos»
  --
  -- Estado interno --
  - List<InstanceHolder<Numeric>> registeredNumericInstances
  - List<InstanceHolder<SampleArray>> registeredSampleArrayInstances
  - List<InstanceHolder<AlarmLimit>> registeredAlarmLimitInstances
  - List<InstanceHolder<LocalAlarmLimitObjective>> ...
  - Map<String, InstanceHolder<Alert>> patientAlertInstances
  - Map<String, InstanceHolder<Alert>> technicalAlertInstances
  - Map<InstanceHandle_t, MetricAndType> instanceToAlarmLimit
}

class "InstanceHolder<T>" as IH {
  + T data
  + InstanceHandle_t handle
}

class "NullSaveContainer<T>" as NSC {
  + boolean isNull()
  + Iterator<T> iterator()
  + int size()
}
class "ArrayContainer<T>" as AC
class "CollectionContainer<T>" as CC
class "MetricAndType" as MAT
class "DomainClock" as DC <<implements DeviceClock>>

class "AbstractConnectedDevice" as ACD {
  # StateMachine<ConnectionState> stateMachine
  # DeviceConnectivity deviceConnectivity
  + {abstract} boolean connect(String)
  + {abstract} void disconnect()
  + {abstract} ConnectionType getConnectionType()
  + getState() / awaitState(state, timeout)
  # setConnectionInfo(String)
}

class "AbstractSerialDevice" as ASD {
  # SerialSocket[] socket
  # TimeAwareInputStream[] timeAwareInputStream
  # SerialProvider[] serialProvider
  + {abstract} void doInitCommands(int idx)
  + {abstract} void process(int idx, in, out)
  + reportConnected(idx, note) «dispara la transición»
}

class "AbstractDelegatingSerialDevice<T>" as ADSD
class "AbstractSimulatedDevice" as ASDV
class "AbstractSimulatedConnectedDevice" as ASC
class "DeviceClock" as DCK <<interface>>
class "Reading" as RDG <<nested>>

AbstractDevice *-- IH
AbstractDevice *-- NSC
NSC <|-- AC
NSC <|-- CC
AbstractDevice --> MAT
AbstractDevice --> DC
DC ..|> DCK
DCK *-- RDG

AbstractDevice <|-- ACD
AbstractDevice <|-- ASDV
ASD <|-- ACD
ADSD <|-- ASD
ASC <|-- ACD

note right of AbstractDevice
  **Responsabilidad única:**
  traducir datos del dispositivo a
  escrituras DDS y llevar el registro
  de instancias.

  NO conoce el protocolo del equipo,
  NO abre sockets, NO parsea bytes.
end note

note bottom of AbstractDevice
  Las claves @key de cada struct IDL son
  la identidad de instancia en DDS.
  AbstractDevice guardará un handle por
  combinación de claves.
end note
@enduml


